    public static void removeDuplicates(String s){
        s=s.replaceAll("\\s","").toLowerCase() ; //remove whitespace from the string using replaceAll() method
        for (int i=0;i<s.length();i++){
            char ch=s.charAt(i);
            if (s.indexOf(ch)==i){ //remove duplicate characters from the string using indexOf() method to check if the character has been seen before
                System.out.print(ch);//print the character if it is the first occurrence
            }
        }
        System.out.println();

    }
    public static void checkAnagram(String s1, String s2){
        s1=s1.replaceAll("\\s","").toLowerCase();
        s2=s2.replaceAll("\\s","").toLowerCase();
        if (s1.length()!=s2.length()){
            System.out.println("The strings are not anagrams.");
            return; 
    }
    
        char[] arr1=s1.toCharArray();
        char[] arr2=s2.toCharArray();
        Arrays.sort(arr1);
        Arrays.sort(arr2);
        if (Arrays.equals(arr1,arr2)){
            System.out.println("The strings are anagrams.");
        } else {
            System.out.println("The strings are not anagrams.");
        }
    }
    public static void slidingWindow(String s){
        int n=s.length();
        int k=3; //size of the window
        for (int i=0;i<=n-k;i++){
            String window=s.substring(i,i+k); //get the substring of size k starting from index i
            System.out.println(window);
        }
    }
    public static void patternMatching(String s){
        String pattern="ali";
        int index=s.indexOf(pattern); //find the index of the first occurrence of the pattern in the string using indexOf() method
        if (index==-1){
            System.out.println("The pattern " + pattern + " is not found in the string.");
        } else {
            System.out.println("The pattern " + pattern + " is found at index " + index + " in the string.");
        }
    }
