//implementation of queue using array

class Queue{
    int[]arr;
    int rear;
    int front;
    int size;

    public Queue (int size){
        this.size=size;
        arr=new int [size];
        front=-1;
        rear=-1;
    }

    void enqueue(int data){
        if(rear==size-1){
            System.out.println("Queue is full");
        }
        else if (front==-1 && rear==-1)
        {
            front=0;
            rear=0;
            arr[rear]=data;
        }
        else{
            rear++;
            arr[rear]=data;
        }
}
 void dequeue(){
        if (front==-1 && rear==-1 ||front>rear){
            System.out.println("Queue is empty");
        }
        else if (front==rear){
            front=-1;
            rear=-1;
        }
        else{
            System.out.println("Removed: " + arr[front]);
            front++;
        }
    }
    void display(){
        if (front==-1 && rear==-1){
            System.out.println("Queue is empty");
        }
        else{
            System.out.print("Queue elements: ");
            for(int i=front;i<=rear;i++){
                System.out.print(arr[i]+" ");
            }
            System.out.println();
        }
    }
    void peek(){
        if (front==-1 && rear==-1){
            System.out.println("Queue is empty");
        }
        else{
            System.out.println("Front element: " + arr[front]);
        }
    }
    void isEmpty(){
        if(front==-1 && rear==-1){
            System.out.println("Queue is empty");
        }
        else{
            System.out.println("Queue is not empty");
        }
    }
    void isFull(){
        if(rear==size-1){
            System.out.println("Queue is full");
        }
        else{
            System.out.println("Queue is not full");
        }
    }

    public static void main(String[] args) {
        Queue queue=new Queue(5);
        queue.enqueue(10);
        queue.enqueue(20);
        queue.enqueue(30);
        queue.enqueue(40);
        queue.enqueue(50);
        queue.display();
        queue.peek();
        queue.isEmpty();
        queue.isFull();
        queue.dequeue();
        queue.display();
    }

}
