import java.util.*;

class Graph {
   int nodeCount;
   ArrayList<String>nodes;
   ArrayList<ArrayList<Integer>> graph;

   public Graph(int nodeCount) {
      this.nodeCount = 0;
      nodes = new ArrayList<>();
      graph = new ArrayList<>();
   }

   public static void main(String[] args) {
      Graph graph = new Graph(5);
      Scanner sc = new Scanner(System.in);
      int choice;
      do {
         System.out.println(
               "/n1. Add node /n 2.Add edge /n 3. Add edge undirected weighted graph /n 4. Add edge directed weighted graph /n 5. Display graph /n 6. Delete operations /n 7. Exit");
         System.out.println("Enter your choice");
         choice = sc.nextInt();
         switch (choice) {
            case 1:
               System.out.println("Enter node value");
               String nodeValue = sc.nextLine();
               graph.addNode(nodeValue);
               break;
            case 2:
               System.out.println("Enter source node index");
               int sourceIndex = sc.nextInt();
               System.out.println("Enter destination node index");
               int destIndex = sc.nextInt();
               graph.addEdge(sourceIndex, destIndex);
               break;
            case 3:
               System.out.println("Enter source node index");
               int sourceIndexW = sc.nextInt();
               System.out.println("Enter destination node index");
               int destIndexW = sc.nextInt();
               System.out.println("Enter weight");
               int weight = sc.nextInt();
               graph.addEdgeUndirectedWeighted(sourceIndexW, destIndexW, weight);
               break;
            case 4:
               System.out.println("Enter source node index");
               int sourceIndexDW = sc.nextInt();
               System.out.println("Enter destination node index");
               int destIndexDW = sc.nextInt();
               System.out.println("Enter weight");
               int weightDW = sc.nextInt();
               graph.addEdgeDirectedWeighted(sourceIndexDW, destIndexDW, weightDW);
               break;
            case 5:
               graph.displayGraph();
               break;
            case 6:
               System.out.println("Delete operations not implemented yet");
               break;
            case 7:
               System.out.println("Exiting...");
               break;
            default:
               System.out.println("Invalid choice. Please try again.");
         }
      } while (choice != 7);
      sc.close();
   }
}
