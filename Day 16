import java.util.*;
class Solution {
    public static void main (String[]args){
        Scanner sc=new Scanner(System.in);
        String s=sc.nextLine();
        traverseString(s);
        countFrequency(s);
        reverseString(s);
        checkPalindrome(s);
        toggleCase(s);
        removeDuplicates(s);
        slidingWindow(s);
        patternMatching(s);
            
        System.out.print("s1: ");
        String s1=sc.nextLine();
        System.out.print(" s2: ");
        String s2=sc.nextLine();
        checkAnagram(s1,s2);
       

    }
    public static void traverseString(String s) {
        for (int i=0;i<s.length();i++){
            System.out.println(s.charAt(i));//traverse the string using for loop and charAt() method
        }
        for (char c : s.toCharArray()){ //convert string to an array of character and then traverse it using for each loop
            System.out.println(c);
        } 
    }
    public static void countFrequency(String s){
        Map <Character, Integer> freq=new HashMap<>();
        for (char ch:s.toCharArray()){
            freq.put(ch,freq.getOrDefault(ch,0)+1); //count the frequency of each character in the string using a hash map
        }
        for (Map.Entry<Character, Integer> entry: freq.entrySet()){
            System.out.println(entry.getKey()+":"+entry.getValue());
        }

    }
    public static void reverseString(String s){
        StringBuilder sb=new StringBuilder(s);
        System.out.println(sb.reverse().toString()); //reverse the string using StringBuilder class and its reverse() method    
    }
    public static void checkPalindrome(String s){
        StringBuilder sb=new StringBuilder(s);
        String reversed=sb.reverse().toString();
        if (s.equals(reversed)){
            System.out.println("The string " + s+ " is a palindrome.");
        } else {
            System.out.println("The string " + s+ " is not a palindrome.");  
        }
    }
    public static void toggleCase(String s){
        StringBuilder sb=new StringBuilder();
        for (char ch:s.toCharArray()){
            if (Character.isUpperCase(ch)){
                sb.append(Character.toLowerCase(ch)); //toggle the case of each character in the string using Character class methods
            } else if (Character.isLowerCase(ch)){
                sb.append(Character.toUpperCase(ch));
            } else {
                sb.append(ch); //if the character is not a letter, keep it unchanged
            }
        }
        System.out.println(sb.toString());
        
    }
