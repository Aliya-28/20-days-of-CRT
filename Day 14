   //time conversion
     public static String timeConversion(String s) {
    // Write your code here
    String hourStr = s.substring(0, 2);
    String timeModifier = s.substring(8, 10);
    String remainingTime = s.substring(2, 8); 
    
    int hour = Integer.parseInt(hourStr);
    
  
    if (timeModifier.equals("AM")) {
        if (hour == 12) {
            hourStr = "00";
        }
    } else { 
        if (hour != 12) {
            hour += 12;
            hourStr = String.valueOf(hour);
        }
    }
    

    return hourStr + remainingTime;
    }


